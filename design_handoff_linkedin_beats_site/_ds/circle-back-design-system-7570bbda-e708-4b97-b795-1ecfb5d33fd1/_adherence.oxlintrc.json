{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/broadcast/**",
              "components/chassis/**",
              "components/controls/**",
              "components/pads/**",
              "components/remix/**",
              "components/sequencer/**",
              "components/stage/**",
              "doc-page.js",
              "ui_kits/circleback/**",
              "ui_kits/lessons/**",
              "ui_kits/museum/**",
              "ui_kits/roast/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowKey'] > JSXAttribute > JSXIdentifier[name!=/^(?:dir|hint|onFire|tone|style|key|ref|className|style|children)$/]",
        "message": "<ArrowKey> doesn't accept that prop. Declared props: dir, hint, onFire, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowKey'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<ArrowKey> dir must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowKey'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|ink)$/]",
        "message": "<ArrowKey> tone must be one of 'light' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Backdrop'] > JSXAttribute > JSXIdentifier[name!=/^(?:cell|alpha|grain|focusRef|key|ref|className|style|children)$/]",
        "message": "<Backdrop> doesn't accept that prop. Declared props: cell, alpha, grain, focusRef."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bay'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|aside|children|style|key|ref|className|style|children)$/]",
        "message": "<Bay> doesn't accept that prop. Declared props: title, aside, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|variant|tone|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: on, variant, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|rec)$/]",
        "message": "<Button> variant must be one of 'default' | 'rec'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|light)$/]",
        "message": "<Button> tone must be one of 'ink' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedComment'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initials|degree|title|text|age|likes|replies|key|ref|className|style|children)$/]",
        "message": "<FeedComment> doesn't accept that prop. Declared props: name, initials, degree, title, text, age, likes, replies."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kbd'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Kbd> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Knob'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|onChange|format|style|key|ref|className|style|children)$/]",
        "message": "<Knob> doesn't accept that prop. Declared props: label, value, defaultValue, onChange, format, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Masthead'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|mark|meta|style|key|ref|className|style|children)$/]",
        "message": "<Masthead> doesn't accept that prop. Declared props: logo, mark, meta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monitor'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|mark|meta|phrase|beats|playhead|levels|reactions|reposts|comments|stamp|glass|style|key|ref|className|style|children)$/]",
        "message": "<Monitor> doesn't accept that prop. Declared props: logo, mark, meta, phrase, beats, playhead, levels, reactions, reposts, comments, stamp, glass, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pad'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|index|hotkey|hot|onTrigger|style|key|ref|className|style|children)$/]",
        "message": "<Pad> doesn't accept that prop. Declared props: name, index, hotkey, hot, onTrigger, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Readout'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|ink|light|style|key|ref|className|style|children)$/]",
        "message": "<Readout> doesn't accept that prop. Declared props: children, ink, light, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RemixMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|key|ref|className|style|children)$/]",
        "message": "<RemixMarker> doesn't accept that prop. Declared props: label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Scrubber'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|format|tone|style|key|ref|className|style|children)$/]",
        "message": "<Scrubber> doesn't accept that prop. Declared props: label, value, onChange, format, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Scrubber'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|light)$/]",
        "message": "<Scrubber> tone must be one of 'ink' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Silk'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|blue|muted|light|style|key|ref|className|style|children)$/]",
        "message": "<Silk> doesn't accept that prop. Declared props: children, blue, muted, light, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageKey'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|caption|on|onFire|tone|style|key|ref|className|style|children)$/]",
        "message": "<StageKey> doesn't accept that prop. Declared props: label, hint, caption, on, onFire, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageKey'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|ink)$/]",
        "message": "<StageKey> tone must be one of 'light' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|ink|angle|style|key|ref|className|style|children)$/]",
        "message": "<Stamp> doesn't accept that prop. Declared props: children, ink, angle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepVoice'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|vox|key|ref|className|style|children)$/]",
        "message": "<StepVoice> doesn't accept that prop. Declared props: name, vox."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|cursor|style|key|ref|className|style|children)$/]",
        "message": "<Ticker> doesn't accept that prop. Declared props: label, children, cursor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Unit'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|narrow|style|key|ref|className|style|children)$/]",
        "message": "<Unit> doesn't accept that prop. Declared props: children, narrow, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
