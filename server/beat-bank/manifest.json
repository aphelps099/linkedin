    },
    {
      "text": "Welcome to the journey, Sarah.",
      "file": "e9773ad015f83ec862aa7cb93ea39e613973ec9df5063781547136d07c99fa7e.wav"
    },
    {
      "text": "Welcome to the journey, Jordan.",
